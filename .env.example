# Copy this file to .env for local development and fill in real values.
# .env itself is gitignored — never commit real secrets.

# Always use an absolute path, both locally and in production — a relative
# "file:./dev.db" gets resolved differently by the Prisma CLI (relative to
# prisma/schema.prisma) than by Next's bundled server (relative to process
# cwd), which silently points at the wrong file.
#
# Local dev: replace with your own absolute path, e.g. run `pwd` in the
# project folder and append /prisma/dev.db to it.
# Production (Railway): the path into the mounted volume, e.g. file:/data/prod.db
DATABASE_URL="file:/absolute/path/to/ai-planner/prisma/dev.db"

# The one shared password that gates the whole app (see middleware.ts).
SITE_PASSWORD="changeme"
