# Copy this file to .env for local development and fill in real values.
# .env itself is gitignored — never commit real secrets.

# A Postgres connection string. Get this from Vercel's dashboard: your
# project -> Storage tab -> create a Postgres database (Neon-backed, free
# tier) -> it's added to your project's env vars automatically. Copy that
# same value here for local development — for a personal single-user app,
# sharing one free database between local dev and production is the
# simplest option; see roadmap.md's Decision Log if that ever needs to change.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The one shared password that gates the whole app (see proxy.ts).
SITE_PASSWORD="changeme"
