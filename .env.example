# Copy this file to .env for local development and fill in real values.
# .env itself is gitignored — never commit real secrets.

# Local dev: a file path, relative to prisma/schema.prisma's folder.
# Production (Railway): an absolute path into the mounted volume, e.g. file:/data/prod.db
DATABASE_URL="file:./dev.db"

# The one shared password that gates the whole app (see middleware.ts).
SITE_PASSWORD="changeme"
